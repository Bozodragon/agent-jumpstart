      },
      "files": {
        "x64": "-x64\\.exe$",
        "arm64": "-arm64\\.exe$"
      },
      "install": {
        "folder": "t3code",
        "arguments": ["/S", "--force-run"],
        "versionIn": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\e9197887-efb3-55e0-985e-d6d3b5dd594a",
